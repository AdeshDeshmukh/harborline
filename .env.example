# Proposed configuration inventory; the current static page reads none of these.
# All entries are optional for the scaffold. Confirm names/requirements when
# implementing the consuming module; this is not a verified provider contract.
# Copy to .env.local only when needed. Never add real secrets to this file.

# Planned public application and Supabase client configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Planned server-only configuration; never use NEXT_PUBLIC_ for these secrets.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRUE_MARKETS_ORGANIZATION_ID=
TRUE_MARKETS_API_KEY_ID=
TRUE_MARKETS_API_PRIVATE_KEY=
SIGNER_ENCRYPTION_KEY=
CRON_SECRET=

# Proposed controls for future server enforcement. These values alone do not
# implement a kill switch; there are currently no financial action endpoints.
TRADING_ENABLED=false
SETTLEMENT_AUTO_RELEASE=false
