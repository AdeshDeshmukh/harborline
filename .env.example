# The static sample needs no credentials. Gateway configuration is read lazily
# only when a server caller explicitly requests the live client.
# Copy to .env.local only when needed. Never add real secrets to this file.

# demo is the default. Pilot auth needs the app/Supabase configuration below;
# the Gateway client independently requires the three TRUE_MARKETS values.
APP_MODE=demo

# Public application and Supabase Auth configuration (see docs/authentication.md)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public key. Never put an sb_secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT supported as fallback; not needed with a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Planned server-only configuration; never use NEXT_PUBLIC_ for these secrets.
# Runtime login: member of harborline_app only; never use the migration admin.
DATABASE_URL=
# Administrator migration URL, used only with an explicit db:migrate --target.
# Keep it out of the running application environment.
MIGRATION_DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRUE_MARKETS_ORGANIZATION_ID=
TRUE_MARKETS_API_KEY_ID=
# A JSON-encoded P-256 private JWK from the organization's API key file.
# This is the organization authentication key, not a customer wallet signer.
TRUE_MARKETS_API_PRIVATE_KEY=
SIGNER_ENCRYPTION_KEY=
CRON_SECRET=

# Proposed controls for future server enforcement. These values alone do not
# implement a kill switch; there are currently no financial action endpoints.
TRADING_ENABLED=false
SETTLEMENT_AUTO_RELEASE=false
