{
  "name": "harborline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:provider && pnpm test:gateway",
    "test:gateway": "vitest run",
    "test:provider": "node --test scripts/verify-readonly-provider.test.mjs",
    "verify:provider": "node scripts/verify-readonly-provider.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24 <27"
  }
}
