          "to": [
            "harborline_app"
          ],
          "using": "\"harborline\".\"gateway_accounts\".\"owner_id\" = nullif(current_setting('harborline.owner_id', true), '')::uuid",
          "withCheck": "\"harborline\".\"gateway_accounts\".\"owner_id\" = nullif(current_setting('harborline.owner_id', true), '')::uuid"
        },
        "gateway_accounts_key_lookup": {
          "name": "gateway_accounts_key_lookup",
          "as": "PERMISSIVE",
