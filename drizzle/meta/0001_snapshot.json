        "external_ref_format": {
          "name": "external_ref_format",
          "value": "\"harborline\".\"gateway_accounts\".\"external_ref_id\" ~ '^[A-Za-z0-9_-]{1,64}$'"
        },
        "signer_public_key_format": {
          "name": "signer_public_key_format",
          "value": "\"harborline\".\"gateway_accounts\".\"public_key\" IS NULL OR \"harborline\".\"gateway_accounts\".\"public_key\" ~ '^(02|03)[0-9a-fA-F]{64}$'"
        },
        "wallet_addresses_object": {
          "name": "wallet_addresses_object",
          "value": "jsonb_typeof(\"harborline\".\"gateway_accounts\".\"wallet_addresses\") = 'object'"
