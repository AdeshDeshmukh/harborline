        "commitments_owner": {
          "name": "commitments_owner",
          "as": "PERMISSIVE",
          "for": "ALL",
          "to": [
            "harborline_app"
          ],
          "using": "exists (select 1 from harborline.gateway_accounts a where a.id = \"harborline\".\"commitments\".\"account_id\" and a.owner_id = nullif(current_setting('harborline.owner_id', true), '')::uuid)",
          "withCheck": "exists (select 1 from harborline.gateway_accounts a where a.id = \"harborline\".\"commitments\".\"account_id\" and a.owner_id = nullif(current_setting('harborline.owner_id', true), '')::uuid)"
        }
      },
      "checkConstraints": {
        "commitment_label_nonempty": {
          "name": "commitment_label_nonempty",
          "value": "length(trim(\"harborline\".\"commitments\".\"label\")) > 0 AND \"harborline\".\"commitments\".\"label\" !~ '[[:cntrl:]]'"
        },
        "commitment_amount_valid": {
          "name": "commitment_amount_valid",
          "value": "\"harborline\".\"commitments\".\"amount\" > 0 AND \"harborline\".\"commitments\".\"amount\" <> 'NaN'::numeric AND \"harborline\".\"commitments\".\"amount\" = trunc(\"harborline\".\"commitments\".\"amount\", 2)"
        },
        "commitment_date_range": {
          "name": "commitment_date_range",
          "value": "\"harborline\".\"commitments\".\"due_date\" BETWEEN DATE '0001-01-01' AND DATE '9999-12-31'"
        },
        "commitment_revision_positive": {
          "name": "commitment_revision_positive",
          "value": "\"harborline\".\"commitments\".\"revision\" >= 1"
        }
      },
      "isRLSEnabled": true
    },
