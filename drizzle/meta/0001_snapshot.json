        },
        "ready_account_identity": {
          "name": "ready_account_identity",
          "value": "\"harborline\".\"gateway_accounts\".\"provisioning_state\" <> 'READY' OR (\"harborline\".\"gateway_accounts\".\"provider_user_id\" IS NOT NULL AND \"harborline\".\"gateway_accounts\".\"public_key\" IS NOT NULL AND \"harborline\".\"gateway_accounts\".\"wallet_addresses\" <> '{}'::jsonb)"
        }
